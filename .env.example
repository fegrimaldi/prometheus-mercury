SLACK_BOT_TOKEN="xoxp-your-slack-bot-token"
SLACK_DEFAULT_CHANNEL="#chatops"

TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM="+15555551234"
TWILIO_DEFAULT_TO="+15555556789"

# iCloud+ custom email — smtp.mail.me.com, authenticated with an
# app-specific password (generate at appleid.apple.com > Sign-In and Security).
ICLOUD_EMAIL="your-icloud-address@icloud.com"
ICLOUD_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
ICLOUD_EMAIL_TO="recipient@example.com"
ICLOUD_FROM_NAME="Mercury Alerts"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"
GOOGLE_EMAIL="your-gmail-address@gmail.com"

PORT=9502

NODE_ENV="development"

HEADING="SilverWolf Monitor"
